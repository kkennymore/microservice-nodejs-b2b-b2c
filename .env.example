# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=fenap_marketplace
MYSQL_USER=marketplace
MYSQL_PASSWORD=marketplace123
MYSQL_PORT=3306

# Redis Configuration
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=marketplace
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production-minimum-32-characters

# API Gateway Configuration
GATEWAY_PORT=4000
FRONTEND_URL=http://localhost:3000

# Service Ports (internal only, exposed through gateway)
AUTH_PORT=3001
PRODUCTS_PORT=3002
TRANSACTIONS_PORT=3003
MESSAGING_PORT=3004
NOTIFICATIONS_PORT=3005
ANALYTICS_PORT=3009
SHIPPING_PORT=3010
SYSTEM_PORT=3008

# Nginx Configuration
NGINX_PORT=80
NGINX_SSL_PORT=443

# Admin Dashboard
ADMIN_PORT=3000
VITE_API_URL=http://localhost:4000

# Email Configuration (for notifications and alerts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
ALERT_EMAIL_RECIPIENTS=["admin@platform.com","alerts@platform.com"]

# Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Shipping Carrier Configuration (optional for development)
FEDEX_API_KEY=your_fedex_api_key
FEDEX_SECRET=your_fedex_secret
UPS_ACCESS_KEY=your_ups_access_key
USPS_USERNAME=your_usps_username

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notification Configuration (FCM)
FCM_SERVER_KEY=your_fcm_server_key

# Development/Production Mode
NODE_ENV=production

# Logging Level
LOG_LEVEL=info