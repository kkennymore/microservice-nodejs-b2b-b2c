# Frontend Environment Variables
# Copy this file to .env and update the values as needed

# App Configuration
VITE_APP_NAME=Pligs Marketplace
VITE_APP_VERSION=1.0.0

# API URLs
VITE_API_BASE_URL=http://localhost:4000
VITE_AUTH_API_URL=http://localhost:3001
VITE_PRODUCTS_API_URL=http://localhost:3002
VITE_TRANSACTIONS_API_URL=http://localhost:3003
VITE_MESSAGING_API_URL=http://localhost:3004
VITE_NOTIFICATIONS_API_URL=http://localhost:3005
VITE_ADVERTISING_API_URL=http://localhost:3006
VITE_TICKETING_API_URL=http://localhost:3007
VITE_REVIEWS_API_URL=http://localhost:3008
VITE_PROMOTIONS_API_URL=http://localhost:3009
VITE_SHIPPING_API_URL=http://localhost:3010
VITE_RECOMMENDER_API_URL=http://localhost:3011
VITE_SYSTEM_API_URL=http://localhost:3012
VITE_ANALYTICS_API_URL=http://localhost:3013
VITE_WISHLIST_API_URL=http://localhost:3014
VITE_SEARCH_API_URL=http://localhost:3015
VITE_SEO_API_URL=http://localhost:3016
VITE_LOYALTY_API_URL=http://localhost:3017
VITE_SOCIAL_API_URL=http://localhost:3018
VITE_ENHANCED_ANALYTICS_API_URL=http://localhost:3019

# SEO Configuration
VITE_SITE_NAME=Pligs Multivendor Marketplace
VITE_SITE_URL=https://marketplace.com
VITE_SEO_API=http://localhost:3016/api
VITE_TWITTER_HANDLE=@pligs_marketplace

# Payment Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Analytics & Tracking
VITE_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
VITE_HOTJAR_ID=your_hotjar_id_here
VITE_MIXPANEL_TOKEN=your_mixpanel_token_here

# Social Media
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Feature Flags
VITE_ENABLE_SOCIAL_FEATURES=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_REAL_TIME_CHAT=true

# Performance & Monitoring
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_LOG_LEVEL=info

# CDN & Media
VITE_CDN_URL=https://cdn.marketplace.com
VITE_IMAGE_OPTIMIZATION_ENABLED=true

# WebSocket URLs
VITE_WS_MESSAGING_URL=ws://localhost:3004
VITE_WS_ANALYTICS_URL=ws://localhost:3013
VITE_WS_NOTIFICATIONS_URL=ws://localhost:3005